#!/bin/bash
# Kopíruje kernel a microcode do /boot v nainstalovaném systému.
# Běží v chrootu cílové instalace; zdroj je squashfs záloha
# /usr/share/cibulkaos/boot/ vytvořená při buildu (customize_airootfs.sh).
# DŮLEŽITÉ: --sparse=never zabrání vytvoření sparse díry na konci souboru na Btrfs,
# se kterou má GRUB btrfs ovladač chybu "premature end of file".
set -e

SRC=/usr/share/cibulkaos/boot

mkdir -p /boot
cp --sparse=never "$SRC/vmlinuz-linux"   /boot/
cp --sparse=never "$SRC/amd-ucode.img"   /boot/ 2>/dev/null || true
cp --sparse=never "$SRC/intel-ucode.img" /boot/ 2>/dev/null || true
