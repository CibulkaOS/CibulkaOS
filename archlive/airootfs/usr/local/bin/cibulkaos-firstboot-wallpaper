#!/usr/bin/env bash
# Nastaví tapetu Petra Cibulky při prvním přihlášení do KDE Plasma.
STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/.cibulkaos-wallpaper-set"
WALLPAPER="/usr/share/wallpapers/CibulkaOS/Petr_Cibulka.jpg"

[ -f "$STAMP" ] && exit 0
[ -f "$WALLPAPER" ] || exit 0
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || exit 0

# Počká krátce na start plasmashell
sleep 3
if plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$STAMP")"
    touch "$STAMP"
fi
