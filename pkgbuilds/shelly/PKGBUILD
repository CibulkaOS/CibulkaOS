# Maintainer: CibulkaOS Build System
# Zdroj: https://github.com/Seafoam-Labs/Shelly-ALPM (předkompilované binárky z GitHub Releases)

pkgname=shelly
pkgver=3.4.1
pkgrel=1
pkgdesc='Shelly: Moderní správce balíčků pro Arch Linux (předkompilovaná binárka)'
arch=('x86_64')
url='https://github.com/Seafoam-Labs/Shelly-ALPM'
license=('GPL-3.0-only')
provides=('shelly-bin')
conflicts=('shelly-bin' 'shelly-git')
backup=('etc/shellybuild.conf')
options=('!strip' '!debug')

depends=(
    'pacman'
    'gtk4'
    'glib2'
    'sudo'
    'tar'
    'bash'
    'git'
    'hicolor-icon-theme'
    'dbus'
    'glibc'
    'libarchive'
    'curl'
    'sqlite'
    'dconf'
    'polkit'
    'gnupg'
    'zstd'
    'json-glib'
)
makedepends=('binutils')
optdepends=(
    'fish: doplňování pro Fish'
    'zsh: doplňování pro Zsh'
    'flatpak: správa Flatpak balíčků'
    'fwupd: aktualizace firmwaru'
    'util-linux: izolované buildy (--isolated)'
    'fuse2: spouštění AppImage vyžadujících FUSE 2'
)

source=(
    "Shelly-ALPM-linux-x64-${pkgver}.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/releases/download/v${pkgver}/Shelly-ALPM-linux-x64.tar.gz"
    "shelly-updates-symbolic-${pkgver}.svg::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/assets/shelly-updates-symbolic.svg"
    "shelly-shell-symbolic-${pkgver}.svg::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/assets/shelly-shell-symbolic.svg"
    "shellybuild-${pkgver}.conf::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/shellybuild.conf"
    "com.shellyorg.shelly-${pkgver}.desktop::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/com.shellyorg.shelly.desktop"
    "com.shellyorg.shelly-notifications-${pkgver}.desktop::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/com.shellyorg.shelly-notifications.desktop"
    "shelly-flatpak-integrate-${pkgver}::https://raw.githubusercontent.com/Seafoam-Labs/Shelly-ALPM/v${pkgver}/shelly-flatpak-integrate"
)

sha256sums=(
    '11dd8805a45f2b98fd7fefb08bbe1229c16f6f53a5b41bdb2b28b4b405964469'
    'cfec9274ece30407404b3c41187c465c68f1a6017394ac31c0be937d06f8a850'
    '27eb0cf269296254f45c68c88a27b0e43817bb6107db8e7edb87ea030730bf25'
    '4126da205e91a3ba3b15453c2aeade92f67e16e3386a52aae32fbd3f2e4af9cc'
    '4b7cb0e42eb322de9eb616d22ca05823f91d178db5b8b67497d497ed495aca9c'
    'cf0dc0a6d1865b9010054b36941e7bf4d445c3e7549219889f07ab08283c5c0f'
    '07bca40395c180578450c523ea052b036aa8197d8a871efcce55f937c101c323'
)

package() {
    local shelly_dynamic
    shelly_dynamic=$(LC_ALL=C readelf -d "$srcdir/shelly") || return 1
    if [[ $shelly_dynamic != *'Shared library: [libsqlite3.so.0]'* ]]; then
        printf 'Shelly CLI must directly depend on libsqlite3.so.0\n' >&2
        return 1
    fi
    if [[ $shelly_dynamic != *libalpm.so* ]]; then
        printf 'Shelly CLI must link against libalpm\n' >&2
        return 1
    fi

    # Binárky
    install -Dm755 "$srcdir/shelly-ui" "$pkgdir/usr/bin/shelly-ui"
    install -Dm755 "$srcdir/shelly-notifications" "$pkgdir/usr/bin/shelly-notifications"
    install -Dm755 "$srcdir/shelly" "$pkgdir/usr/bin/shelly"
    install -Dm755 "$srcdir/shelly-key" "$pkgdir/usr/bin/shelly-key"
    install -Dm755 "$srcdir/shelly-flatpak-integrate-${pkgver}" "$pkgdir/usr/bin/shelly-flatpak-integrate"
    install -Dm644 "$srcdir/shellybuild-${pkgver}.conf" "$pkgdir/etc/shellybuild.conf"

    # Desktop soubory (+ český popisek)
    install -Dm644 "$srcdir/com.shellyorg.shelly-${pkgver}.desktop" \
        "$pkgdir/usr/share/applications/com.shellyorg.shelly.desktop"
    if ! grep -q '^Comment\[cs\]=' "$pkgdir/usr/share/applications/com.shellyorg.shelly.desktop"; then
        sed -i '/^Comment=/a Comment[cs]=Moderní správce balíčků pro Arch Linux' \
            "$pkgdir/usr/share/applications/com.shellyorg.shelly.desktop"
    fi
    install -Dm644 "$srcdir/com.shellyorg.shelly-notifications-${pkgver}.desktop" \
        "$pkgdir/usr/share/applications/com.shellyorg.shelly-notifications.desktop"

    # Polkit pravidlo pro spouštění /usr/bin/shelly přes pkexec (obchází 50% kyvadlo v sudo)
    install -m0755 -d "$pkgdir/usr/share/polkit-1/actions"
    cat <<'EOF' | install -Dm644 /dev/stdin "$pkgdir/usr/share/polkit-1/actions/com.shellyorg.shelly.policy"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shelly</vendor>
  <vendor_url>https://github.com/Seafoam-Labs/Shelly-ALPM</vendor_url>
  <action id="com.shellyorg.shelly.pkexec.cli">
    <description>Run Shelly CLI as administrator</description>
    <description xml:lang="cs">Spustit Shelly jako správce</description>
    <message>Run Shelly CLI with administrator privileges.</message>
    <message xml:lang="cs">Pro správu balíčků v Shelly je potřeba oprávnění správce.</message>
    <icon_name>shelly</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/shelly</annotate>
  </action>
</policyconfig>
EOF

    # Ikony
    install -Dm644 "$srcdir/shellylogo.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly.png"
    install -Dm644 "$srcdir/shellylogo-tray.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly-tray.png"
    install -Dm644 "$srcdir/shellylogo-update.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly-update.png"
    install -Dm644 "$srcdir/shelly-updates-symbolic-${pkgver}.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/shelly-updates-symbolic.svg"
    install -Dm644 "$srcdir/shelly-shell-symbolic-${pkgver}.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/shelly-shell-symbolic.svg"

    # Doplňování shellu
    [ -f "$srcdir/shelly.fish" ] && install -Dm644 "$srcdir/shelly.fish" \
        "$pkgdir/usr/share/fish/vendor_completions.d/shelly.fish"
    [ -f "$srcdir/_shelly" ] && install -Dm644 "$srcdir/_shelly" \
        "$pkgdir/usr/share/zsh/site-functions/_shelly"
    [ -f "$srcdir/shelly.bash" ] && install -Dm644 "$srcdir/shelly.bash" \
        "$pkgdir/usr/share/bash-completion/completions/shelly"

    # Manuálová stránka (volitelně, pokud je na hostiteli go-md2man)
    if command -v go-md2man >/dev/null 2>&1; then
        "$srcdir/shelly" utility --docs | go-md2man > "$srcdir/shelly.1"
        sed -i "s|^\\.TH .*|.TH \"SHELLY\" \"1\" \"\" \"Shelly ${pkgver}\" \"Shelly CLI Manual\"|" "$srcdir/shelly.1"
        printf '\n.SH AUTHORS\nSeafoam Labs.\n' >> "$srcdir/shelly.1"
        install -Dm644 "$srcdir/shelly.1" "$pkgdir/usr/share/man/man1/shelly.1"
    fi

    # Překlady
    if [ -d "$srcdir/locale" ] && [ -n "$(ls -A "$srcdir/locale" 2>/dev/null)" ]; then
        install -d "$pkgdir/usr/share/locale"
        cp -r "$srcdir/locale/."/* "$pkgdir/usr/share/locale/" 2>/dev/null || true
    fi
}
